<Window x:Class="YHPCReviewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YHPCReviewer.UI"
        Title="AYT AI ayarları"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBg}" ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,22">
        <StackPanel Orientation="Horizontal">
            <Grid Width="44" Height="44">
                <Border CornerRadius="11" Background="{DynamicResource Accent}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="21" Foreground="White" HorizontalAlignment="Center" />
            </Grid>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AYT AI bağlantısı" Style="{StaticResource Title2}" />
                <TextBlock Text="OpenAI uyumlu (chat/completions) API" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="BAĞLANTI" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Text="API adresi" Style="{StaticResource Headline}" FontSize="13" />
                <TextBox x:Name="EndpointBox" Tag="https://api.ornek.com/v1" Margin="0,6,0,0" TextChanged="Field_Changed" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,5,0,0" TextWrapping="Wrap"
                           Text="Temel adres (…/v1) ya da tam …/chat/completions adresi olabilir." />

                <TextBlock Text="API anahtarı" Style="{StaticResource Headline}" FontSize="13" Margin="0,16,0,0" />
                <PasswordBox x:Name="KeyBox" Margin="0,6,0,0" PasswordChanged="Field_Changed" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,5,0,0" TextWrapping="Wrap"
                           Text="Windows tarafından şifrelenip yalnızca bu kullanıcı hesabında saklanır; raporlara asla eklenmez." />

                <TextBlock Text="Model" Style="{StaticResource Headline}" FontSize="13" Margin="0,16,0,0" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelBox" Tag="Boş bırakılırsa sunucunun varsayılanı" />
                    <Button x:Name="ModelsButton" Grid.Column="1" Margin="8,0,0,0" Click="Models_Click" ToolTip="Sunucudaki modelleri listele">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Modeller" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Test sonucu: durum geri bildirimi satır içinde, kaydetmeden önce -->
        <Border x:Name="TestPanel" Background="{DynamicResource Fill}" CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
            <DockPanel>
                <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource TintedButton}" Click="Test_Click" VerticalAlignment="Center">
                    <TextBlock Text="Bağlantıyı test et" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                </Button>
                <ui:Spinner x:Name="TestSpinner" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TestIcon" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Visibility="Collapsed" />
                <TextBlock x:Name="TestText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Kaydetmeden önce bağlantıyı deneyebilirsin." />
            </DockPanel>
        </Border>

        <Border Background="{DynamicResource Fill}" CornerRadius="10" Padding="14,11" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource Green}" Margin="0,2,9,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="17"
                           Text="AYT AI yalnızca sen bir soru sorduğunda çalışır. İlk soruda rapor, kişisel bilgiler gizlenmiş hâliyle ve senin onayınla gönderilir." />
            </DockPanel>
        </Border>

        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource PlainButton}" Click="Disconnect_Click" x:Name="DisconnectButton">
                <TextBlock Text="Bağlantıyı kaldır" Foreground="{DynamicResource Red}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource FilledButton}" IsDefault="True" Click="Save_Click" Padding="20,7">
                <TextBlock Text="Kaydet" Foreground="White" />
            </Button>
            <Button DockPanel.Dock="Right" Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>

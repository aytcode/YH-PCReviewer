<Window x:Class="YHPCReviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YHPCReviewer.UI"
        Title="YH PC Reviewer"
        Width="1180" Height="780" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True">

    <!--
        Birleşik başlık çubuğu: içerik pencerenin en üstüne kadar uzanır, Windows yalnızca
        simge durumu/kapat düğmelerini çizer (macOS'taki kenar çubuklu pencereler gibi).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Durum simgesi: renk + şekil (yalnızca renge dayanmaz) -->
        <DataTemplate x:Key="StatusGlyph">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0"
                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
        </DataTemplate>

        <!-- Bulgu satırı: başlık + özet; tıklayınca adımlar, düzeltmeler ve teknik ayrıntı açılır -->
        <DataTemplate x:Key="FindingRow">
            <Grid>
                <Rectangle Style="{StaticResource RowSeparator}" />
                <StackPanel>
                    <ToggleButton x:Name="hdr" Style="{StaticResource DisclosureRow}" IsChecked="{Binding IsProblem, Mode=OneTime}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusGlyph}" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="13" LineHeight="19" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <!-- Açılan bölüm -->
                    <StackPanel Margin="48,0,24,16" Visibility="{Binding IsChecked, ElementName=hdr, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding Steps}" AlternationCount="100" Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TertiaryLabel}" Margin="0,1,0,0"
                                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource PlusOne}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" FontSize="13" LineHeight="19" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,6,0,0" Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TintedButton}" Margin="0,0,8,8" Click="FixAction_Click" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Style="{StaticResource Disclosure}" Header="Teknik ayrıntı" Margin="0,4,0,0"
                                  Visibility="{Binding HasDetails, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" LineHeight="17"
                                       Foreground="{DynamicResource SecondaryLabel}" Margin="16,0,0,0" />
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Genel bakıştaki kısa satır: bulgular sayfasına götürür -->
        <DataTemplate x:Key="ProblemLinkRow">
            <Grid>
                <Rectangle Style="{StaticResource RowSeparator}" />
                <Button Style="{StaticResource LinkRow}" Click="GoToFindings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusGlyph}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       ToolTip="{Binding Summary}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Özellik satırı ("Bu Mac Hakkında" gibi: solda ad, sağda değer) -->
        <DataTemplate x:Key="SpecRow">
            <Grid>
                <Rectangle Style="{StaticResource RowSeparator}" />
                <Grid Margin="16,12,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource SecondaryLabel}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Top" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="Medium" TextAlignment="Right" TextWrapping="Wrap" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,2,0,0"
                                   Visibility="{Binding Sub, Converter={StaticResource NullVis}}" />
                        <ProgressBar Width="140" Height="4" HorizontalAlignment="Right" Margin="0,7,0,0" Value="{Binding MeterValue, Mode=OneWay}"
                                     Foreground="{Binding RiskPercent, Converter={StaticResource PercentBrush}}"
                                     Visibility="{Binding HasMeter, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="CanContentScroll" Value="False" />
        </Style>
        <!-- Okunabilir satır uzunluğu için içerik genişliği sınırlı -->
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="MaxWidth" Value="780" />
            <Setter Property="Margin" Value="48,56,48,48" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Kenar çubuğu (Mica) ============ -->
        <DockPanel Background="{DynamicResource SidebarBg}" Margin="12,0,12,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,14,0,26" IsHitTestVisible="False">
                <Image Source="{StaticResource Logo}" Width="18" Height="18" />
                <TextBlock Text="YH PC Reviewer" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Button Style="{StaticResource FilledButton}" Click="Analyze_Click" Padding="12,9" IsEnabled="{Binding IsAnalyzing, Converter={x:Static ui:InvertBool.Instance}}">
                    <TextBlock x:Name="AnalyzeLabel" Text="Sorunları analiz et" Foreground="White" FontWeight="SemiBold" />
                </Button>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="2,12,0,0" Foreground="{DynamicResource TertiaryLabel}" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="Nav" Style="{StaticResource SidebarList}" ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="Nav_SelectionChanged"
                     KeyboardNavigation.TabNavigation="Once">
                <ListBoxItem Tag="overview" IsSelected="True" AutomationProperties.Name="Genel bakış">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock Text="Genel bakış" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem Tag="findings" AutomationProperties.Name="Bulgular">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProblemCount}" FontSize="12" Foreground="{DynamicResource SecondaryLabel}" VerticalAlignment="Center"
                                   Visibility="{Binding ProblemCount, Converter={StaticResource CountVis}}" />
                        <TextBlock Text="Bulgular" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem Tag="network" AutomationProperties.Name="İnternet">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock Text="İnternet" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem Tag="apps" AutomationProperties.Name="Uygulamalar">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock Text="Uygulamalar ve oyunlar" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem Tag="history" AutomationProperties.Name="Geçmiş">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock Text="Geçmiş" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>

                <ListBoxItem IsEnabled="False" Focusable="False" Height="18" />

                <ListBoxItem Tag="ai" AutomationProperties.Name="AYT AI">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="14" Foreground="{DynamicResource Accent}" Width="26" />
                        <TextBlock Text="AYT AI" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem Tag="settings" AutomationProperties.Name="Ayarlar">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14" Foreground="{DynamicResource SecondaryLabel}" Width="26" />
                        <TextBlock Text="Ayarlar" FontSize="13.5" VerticalAlignment="Center" />
                    </DockPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ============ İçerik ============ -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1,0,0,0">
            <Grid x:Name="PageHost" ClipToBounds="True">

                <!-- ===== Genel bakış ===== -->
                <ScrollViewer x:Name="Page_overview" Style="{StaticResource Page}" Visibility="Visible">
                    <StackPanel Style="{StaticResource PageBody}">

                        <!-- Boş durum: kart yok, doğrudan zeminde -->
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520" Margin="0,70,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}">
                            <Image Source="{StaticResource Logo}" Width="72" Height="72" />
                            <TextBlock Text="Bilgisayarında bir sorun mu var?" Style="{StaticResource Display}" FontSize="28" TextAlignment="Center" Margin="0,26,0,12" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="14.5" LineHeight="22" TextAlignment="Center"
                                       Text="İnternet bağlanmıyor, oyunlar açılmıyor, bilgisayar yavaşladı ya da kendi kendine kapanıyor… YH PC Reviewer bilgisayarını inceler, sorunu sade bir dille anlatır ve ne yapacağını adım adım söyler." />
                            <Button Style="{StaticResource LargeFilledButton}" Click="Analyze_Click" HorizontalAlignment="Center" Margin="0,30,0,0">
                                <TextBlock Text="Sorunları analiz et" Foreground="White" />
                            </Button>
                            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,16,0,0" Foreground="{DynamicResource TertiaryLabel}"
                                       Text="Yaklaşık 15 saniye sürer. Sen onaylamadan hiçbir şey değiştirilmez ya da gönderilmez." />
                        </StackPanel>

                        <!-- Analiz sürüyor -->
                        <StackPanel HorizontalAlignment="Center" Width="360" Margin="0,90,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="İnceleniyor…" Style="{StaticResource Title2}" HorizontalAlignment="Center" />
                            <TextBlock Text="Bu sırada bilgisayarını kullanmaya devam edebilirsin." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,26" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Spinner Width="16" Height="16" HorizontalAlignment="Left" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Foreground="{DynamicResource Green}" HorizontalAlignment="Left"
                                                       Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" />
                                            <Ellipse Width="6" Height="6" Margin="5,0,0,0" HorizontalAlignment="Left" Fill="{DynamicResource TertiaryLabel}"
                                                     Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TertiaryLabel}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryLabel}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Sonuç -->
                        <StackPanel x:Name="OverviewResult">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasReport}" Value="True" />
                                                <Condition Binding="{Binding IsAnalyzing}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Durum: tek cümle, büyük tipografi; halka yalnızca destekler -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Display}" />
                                    <TextBlock Style="{StaticResource Secondary}" FontSize="14" Margin="0,8,0,0">
                                        <Run Text="Sağlık puanı " /><Run Text="{Binding Report.HealthScore, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Label}" /><Run Text=" · " /><Run Text="{Binding Report.CreatedAtDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ScoreDeltaText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding ScoreDeltaText, Converter={StaticResource NullVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                        <Button Style="{StaticResource FilledButton}" Click="GoToFindings_Click" Margin="0,0,10,0" Padding="16,8">
                                            <TextBlock Text="Çözümleri gör" Foreground="White" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="AskAi_Click" Margin="0,0,10,0" Padding="14,8">
                                            <TextBlock Text="AYT AI'ye sor" />
                                        </Button>
                                        <Button Click="Export_Click" Padding="14,8" ToolTip="Kişisel bilgileri gizleyerek kaydet ya da kopyala">
                                            <TextBlock Text="Raporu paylaş" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="128" Height="128" VerticalAlignment="Center">
                                    <ui:ScoreRing StrokeWidth="11" Target="{Binding Report.HealthScore}" TrackBrush="{DynamicResource Track}"
                                                  RingBrush="{Binding Report.ScoreSeverity, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Text="{Binding Report.HealthScore}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <StackPanel Visibility="{Binding ProblemCount, Converter={StaticResource CountVis}}">
                                <TextBlock Text="Dikkat gerekenler" Style="{StaticResource GroupHeader}" Margin="2,40,0,10" />
                                <Border Style="{StaticResource Group}">
                                    <ItemsControl ItemsSource="{Binding ProblemResults}" ItemTemplate="{StaticResource ProblemLinkRow}" AlternationCount="1000" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Bu bilgisayar" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <!-- Cihaz başlığı -->
                                    <Grid Margin="16,14,18,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Fill}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="22" Foreground="{DynamicResource SecondaryLabel}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Report.System.Motherboard}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Secondary}">
                                                <Run Text="{Binding Report.System.OsName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Report.System.OsBuild, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="16,0,0,0" />
                                    <ItemsControl ItemsSource="{Binding SpecTiles}" ItemTemplate="{StaticResource SpecRow}" AlternationCount="1000" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Bulgular ===== -->
                <ScrollViewer x:Name="Page_findings" Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Bulgular" Style="{StaticResource LargeTitle}" />
                        <TextBlock Text="Bir satıra tıklayarak ne yapman gerektiğini ve tek tıkla deneyebileceğin düzeltmeleri gör." Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,6,0,0" />

                        <TextBlock Text="Henüz analiz yapılmadı. Kenar çubuğundaki “Sorunları analiz et” düğmesine bas." Style="{StaticResource Secondary}" Margin="0,30,0,0"
                                   Visibility="{Binding HasReport, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding ProblemResults.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="Dikkat gerekenler" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <ItemsControl ItemsSource="{Binding ProblemResults}" ItemTemplate="{StaticResource FindingRow}" AlternationCount="1000" />
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding InfoResults.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="Öneriler" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <ItemsControl ItemsSource="{Binding InfoResults}" ItemTemplate="{StaticResource FindingRow}" AlternationCount="1000" />
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding OkResults.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="Sorunsuz" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <ToggleButton x:Name="OkToggle" Style="{StaticResource DisclosureRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Foreground="{DynamicResource Green}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding OkSummary}" Style="{StaticResource RowTitle}" />
                                        </Grid>
                                    </ToggleButton>
                                    <ItemsControl ItemsSource="{Binding OkResults}" Visibility="{Binding IsChecked, ElementName=OkToggle, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Separator}" Margin="48,0,0,0" />
                                                    <Grid Margin="16,10,18,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== İnternet ===== -->
                <ScrollViewer x:Name="Page_network" Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="İnternet" Style="{StaticResource LargeTitle}" />
                        <TextBlock Text="Bağlantın halka halka sınanır; sorunun nerede başladığını buradan görebilirsin." Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,6,0,0" />

                        <!-- Bağlantı zinciri: zeminde, kart yok -->
                        <Grid Margin="0,36,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Top" Margin="0,22,0,0" Fill="{DynamicResource Separator}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Report.NetworkChain}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="44" Height="44">
                                                <Ellipse Fill="{DynamicResource ContentBg}" />
                                                <Ellipse Fill="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}" />
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,10,0,1" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Text="Hız testi" Style="{StaticResource GroupHeader}" />
                        <Border Style="{StaticResource Group}">
                            <Grid Margin="20,14,16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SpeedDisplay}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="Mbps" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Bottom" Margin="6,0,0,8" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding SpeedStatus}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="speed.cloudflare.com üzerinden en fazla 50 MB indirilir." Style="{StaticResource Caption}" Foreground="{DynamicResource TertiaryLabel}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="88">
                                    <Button Click="SpeedTest_Click" Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                        <TextBlock Text="Hızı ölç" />
                                    </Button>
                                    <ui:Spinner Width="18" Height="18" Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Kontroller" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <ItemsControl ItemsSource="{Binding Report.NetworkResults}" ItemTemplate="{StaticResource FindingRow}" AlternationCount="1000" />
                            </Border>

                            <TextBlock Text="Ağ kartları" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <ItemsControl ItemsSource="{Binding Report.ConnectedAdapters}" AlternationCount="1000">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Rectangle Style="{StaticResource RowSeparator}" Margin="16,0,0,0" />
                                                <Grid Margin="16,12,18,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource RowTitle}" />
                                                        <TextBlock Text="{Binding DnsDisplay}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Type}" FontSize="13" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding SpeedMbps, StringFormat={}{0} Mbps}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Uygulamalar ===== -->
                <ScrollViewer x:Name="Page_apps" Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Uygulamalar ve oyunlar" Style="{StaticResource LargeTitle}" />
                        <TextBlock Text="Çöken programlar ve oyunların çalışması için gereken bileşenler." Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,6,0,0" />

                        <TextBlock Text="Henüz analiz yapılmadı." Style="{StaticResource Secondary}" Margin="0,30,0,0"
                                   Visibility="{Binding HasReport, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Durum" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource Group}">
                                <ItemsControl ItemsSource="{Binding Report.AppResults}" ItemTemplate="{StaticResource FindingRow}" AlternationCount="1000" />
                            </Border>

                            <StackPanel Visibility="{Binding Report.AppErrors.Count, Converter={StaticResource CountVis}}">
                                <TextBlock Text="Son 14 gündeki çökmeler" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource Group}">
                                    <ItemsControl ItemsSource="{Binding Report.AppErrors}" AlternationCount="1000">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Rectangle Style="{StaticResource RowSeparator}" Margin="16,0,0,0" />
                                                    <Grid Margin="16,11,18,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Application}" Style="{StaticResource RowTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Application}" />
                                                            <TextBlock Text="{Binding Module, StringFormat=Modül: {0}}" Style="{StaticResource Caption}"
                                                                       Visibility="{Binding Module, Converter={StaticResource NullVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=×{0}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock Grid.Column="3" Text="{Binding LastSeen, StringFormat=d MMM HH:mm}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Geçmiş ===== -->
                <ScrollViewer x:Name="Page_history" Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Click="ClearHistory_Click" VerticalAlignment="Bottom"
                                    Visibility="{Binding History.Count, Converter={StaticResource CountVis}}">
                                <TextBlock Text="Geçmişi temizle" Foreground="{DynamicResource Red}" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Geçmiş" Style="{StaticResource LargeTitle}" />
                                <TextBlock Text="Her analizin özeti yalnızca bu bilgisayarda saklanır." Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Henüz kayıtlı bir analiz yok." Style="{StaticResource Secondary}" Margin="0,30,0,0"
                                   Visibility="{Binding History.Count, Converter={StaticResource CountVis}, ConverterParameter=empty}" />

                        <Border Style="{StaticResource Group}" Margin="0,30,0,0" Visibility="{Binding History.Count, Converter={StaticResource CountVis}}">
                            <ItemsControl ItemsSource="{Binding History}" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Rectangle Style="{StaticResource RowSeparator}" Margin="68,0,0,0" />
                                            <Grid Margin="16,13,18,13">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Score}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Top"
                                                           Typography.NumeralAlignment="Tabular" Foreground="{Binding ScoreSeverity, Converter={StaticResource SeverityBrush}}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Errors, Mode=OneWay}" /><Run Text=" sorun · " /><Run Text="{Binding Warnings, Mode=OneWay}" /><Run Text=" uyarı · " /><Run Text="{Binding ChangeSummary, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding ResolvedIssues}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Green}">
                                                                    <Run Text="Çözüldü: " /><Run Text="{Binding Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding NewIssues}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Orange}">
                                                                    <Run Text="Yeni: " /><Run Text="{Binding Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DeltaDisplay}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryLabel}" Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== AYT AI ===== -->
                <Grid x:Name="Page_ai" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="48,56,48,0" MaxWidth="780">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Click="ClearChat_Click" VerticalAlignment="Bottom"
                                Visibility="{Binding Chat.Count, Converter={StaticResource CountVis}}">
                            <TextBlock Text="Yeni sohbet" Foreground="{DynamicResource Accent}" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="AYT AI" Style="{StaticResource LargeTitle}" />
                            <TextBlock Text="Raporunu yorumlat, aklına takılanı sor." Style="{StaticResource Secondary}" FontSize="13.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Bağlı değil -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460" Margin="48,70,48,0"
                                Visibility="{Binding AiConfigured, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="40" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        <TextBlock Text="AYT AI'yi bağla" Style="{StaticResource Title2}" HorizontalAlignment="Center" Margin="0,18,0,8" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13.5" LineHeight="20" TextAlignment="Center"
                                   Text="API adresini ve anahtarını bir kez gir. Sonra raporunu yorumlatabilir, sorularını sohbet ederek sorabilirsin. Gönderilecek metni her zaman önce sen onaylarsın." />
                        <Button Style="{StaticResource FilledButton}" Click="Settings_Click" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="18,8">
                            <TextBlock Text="Bağlantıyı ayarla" Foreground="White" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>

                    <!-- Sohbet -->
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding AiConfigured, Converter={StaticResource BoolVis}}">
                        <StackPanel MaxWidth="780" Margin="48,0,48,12">
                            <StackPanel Visibility="{Binding Chat.Count, Converter={StaticResource CountVis}, ConverterParameter=empty}" Margin="0,10,0,0">
                                <TextBlock Text="Şunları sorabilirsin" Style="{StaticResource GroupHeader}" Margin="2,0,0,10" />
                                <Border Style="{StaticResource Group}">
                                    <StackPanel>
                                        <Button Style="{StaticResource LinkRow}" Click="Suggestion_Click" Tag="Raporumu yorumla: en önemli sorunlar neler ve nasıl çözerim?">
                                            <TextBlock Text="Raporumu yorumla" FontSize="13.5" />
                                        </Button>
                                        <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="16,0,0,0" />
                                        <Button Style="{StaticResource LinkRow}" Click="Suggestion_Click" Tag="Oyunlarım neden çöküyor ya da açılmıyor? Rapora göre ne yapmalıyım?">
                                            <TextBlock Text="Oyunlarım neden çöküyor?" FontSize="13.5" />
                                        </Button>
                                        <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="16,0,0,0" />
                                        <Button Style="{StaticResource LinkRow}" Click="Suggestion_Click" Tag="İnternetim neden yavaş ya da kopuyor? Rapora göre ne yapmalıyım?">
                                            <TextBlock Text="İnternetim neden yavaş?" FontSize="13.5" />
                                        </Button>
                                        <Rectangle Height="1" Fill="{DynamicResource Separator}" Margin="16,0,0,0" />
                                        <Button Style="{StaticResource LinkRow}" Click="Suggestion_Click" Tag="Bilgisayarım neden yavaş? Rapora göre hızlandırmak için neler yapabilirim?">
                                            <TextBlock Text="Bilgisayarımı nasıl hızlandırırım?" FontSize="13.5" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Chat}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <!-- Kullanıcı -->
                                            <Border HorizontalAlignment="Right" MaxWidth="520" CornerRadius="16" Padding="14,9" Background="{DynamicResource BubbleUser}"
                                                    Visibility="{Binding IsUser, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" />
                                            </Border>
                                            <!-- AYT AI: balon yok, metin doğrudan zeminde (okuma odaklı) -->
                                            <StackPanel Visibility="{Binding IsUser, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="13" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="AYT AI" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    <ui:Spinner Width="12" Height="12" Margin="8,0,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}}" />
                                                </StackPanel>
                                                <ui:MarkdownView Markdown="{Binding Text}" Foreground="{DynamicResource Label}" FontFamily="{StaticResource TextFont}" FontSize="13.5"
                                                                 Visibility="{Binding Text, Converter={StaticResource NullVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="AYT AI hata yapabilir. Önemli adımlardan önce emin ol." Style="{StaticResource Caption}" Foreground="{DynamicResource TertiaryLabel}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="{Binding Chat.Count, Converter={StaticResource CountVis}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Yazma alanı -->
                    <Grid Grid.Row="2" MaxWidth="780" Margin="48,8,48,24" Visibility="{Binding AiConfigured, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="20" Padding="4">
                            <TextBox x:Name="Composer" Tag="AYT AI'ye bir soru sor…" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="120" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Composer_PreviewKeyDown" Padding="12,6"
                                     AutomationProperties.Name="Soru" />
                        </Border>
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                            <Button Width="38" Height="38" Click="Send_Click" ToolTip="Gönder (Enter)" AutomationProperties.Name="Gönder" Cursor="Hand"
                                    Visibility="{Binding IsAiBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse Fill="{DynamicResource Accent}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="14" Foreground="White" HorizontalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="g" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="38" Height="38" Click="Stop_Click" ToolTip="Durdur" AutomationProperties.Name="Durdur" Cursor="Hand"
                                    Visibility="{Binding IsAiBusy, Converter={StaticResource BoolVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{DynamicResource Fill}" />
                                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Label}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Pencere düğmeleri -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Simge durumuna küçült" ToolTip="Simge durumuna küçült" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="Ekranı kapla" ToolTip="Ekranı kapla" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Kapat" ToolTip="Kapat" />
                </StackPanel>

                <!-- Bildirim -->
                <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" Padding="16,10" CornerRadius="18"
                        Background="{DynamicResource Label}" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource Green}" Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText" Foreground="{DynamicResource ContentBg}" FontSize="13" FontWeight="Medium" MaxWidth="540" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YHPCReviewer</AssemblyName>
    <RootNamespace>YHPCReviewer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>YH PC Reviewer</Product>
    <Company>YazılımHub</Company>
    <Authors>aytcode</Authors>
    <Copyright>© 2026 aytcode</Copyright>
    <Description>Bilgisayar sorunlarını teşhis eden Windows aracı.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
